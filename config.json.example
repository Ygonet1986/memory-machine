{
  "capacity": 50,
  "whiteboard_budget": 4000,
  "consolidate_threshold": 6000,
  "context_consolidate_threshold": 6000,
  "attach_chunk_size": 600,
  "router_enabled": false,
  "router_mode": "llm",
  "router_top_k": 5,
  "router_fallback": "full",
  "router_full_every": 0,
  "view_router_mode": "lexical",
  "view_top_k": 5,
  "view_dimension_mode": "off",
  "view_prune": "none",
  "agent_mode": "group",
  "whiteboard_mode": "single",
  "attention_mode": "off",
  "attention_decay": 0.6,
  "attention_boost": 0.8,
  "attention_found_boost": 0.3,
  "attention_weight": 0.5,
  "attention_gate_min": 0.5,
  "attention_gate_margin": 0.1,
  "coverage_mode": "off",
  "cascade_min_score": 0.0,
  "cascade_expand_top_k": 5,
  "embedding_model": "",
  "embedding_base_url": "",
  "embedding_api_key_env": "",
  "model": "deepseek-v4-flash",
  "base_url": "https://api.deepseek.com",
  "api_key_env": "DEEPSEEK_API_KEY",
  "tape_path": "tape.jsonl",
  "manifest_path": "manifest.json",
  "whiteboard_path": "whiteboard.json",
  "context_path": "context.json"
}
